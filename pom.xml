<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>azure-data-lake-storage-gen2-document-files-virtual-schema</artifactId>
    <version>3.0.2</version>
    <name>Virtual Schema for document data in files on Azure Data Lake Storage Gen 2</name>
    <description>Adapter for document data access from files from Azure Data Lake Storage Gen 2.</description>
    <url>https://github.com/exasol/azure-data-lake-storage-gen2-document-files-virtual-schema/</url>
    <properties>
        <vs-common-document-files.version>9.0.0</vs-common-document-files.version>
    </properties>
    <profiles>
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <test.excludeTags>regression</test.excludeTags>
            </properties>
        </profile>
        <profile>
            <id>regressionTests</id>
            <properties>
                <groups>regression</groups>
            </properties>
        </profile>
    </profiles>
    <dependencyManagement>
        <dependencies>
            <!-- Upgrading transitive dependency io.netty:netty-codec-compression:jar:4.2.15.Final:compile of com.azure:azure-storage-file-datalake:jar:12.26.4:compile to fix CVE-2026-59901 -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.16.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Upgrading transitive dependency of com.azure:azure-storage-file-datalake:jar:12.26.4:compile to fix CVE-2026-41715 -->
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty-http</artifactId>
                <version>1.2.18</version>
            </dependency>
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-core:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix GHSA-r7wm-3cxj-wff9 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.18.8</version>
            </dependency>
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-59888 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-59889 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-54515 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-54514 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-54512 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix GHSA-mhm7-754m-9p8w -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.6:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-54513 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.8:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-54515 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.8:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-54518 -->
            <!-- Upgrading transitive dependency com.fasterxml.jackson.core:jackson-databind:jar:2.18.8:compile of com.azure:azure-core:jar:1.58.0:compile to fix CVE-2026-59889 -->            
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.22.1</version>
            </dependency>
            <!-- Upgrading transitive dependency software.amazon.awscdk:aws-cdk-lib:jar:2.167.1:compile to fix GHSA-464c-974j-9xm6 -->
            <dependency>
                <groupId>software.amazon.awscdk</groupId>
                <artifactId>aws-cdk-lib</artifactId>
                <version>2.253.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>virtual-schema-common-document-files</artifactId>
            <version>${vs-common-document-files.version}</version>
        </dependency>
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>error-reporting-java</artifactId>
            <version>1.0.2</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-file-datalake</artifactId>
            <version>12.26.4</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>1.18.3</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-core</artifactId>
            <version>1.58.0</version>
        </dependency>
        <!-- Test dependencies -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>virtual-schema-common-document-files</artifactId>
            <version>${vs-common-document-files.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <!-- JUnit 6 requires Java 17 -->
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <!--Integration test dependencies-->
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>test-db-builder-java</artifactId>
            <version>4.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>udf-debugging-java</artifactId>
            <version>0.6.20</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>hamcrest-resultset-matcher</artifactId>
            <version>1.7.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>exasol-test-setup-abstraction-java</artifactId>
            <version>2.1.11</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.exasol</groupId>
            <artifactId>performance-test-recorder-java</artifactId>
            <version>0.1.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>nl.jqno.equalsverifier</groupId>
            <artifactId>equalsverifier</artifactId>
            <!-- Equalsverifier 4 requires Java 17 -->
            <version>3.19.4</version>
            <scope>test</scope>
        </dependency>
        <!-- Enable log output for testcontainer startup -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <!-- com.azure:azure-core has a transitive dependency on org.slf4j:slf4j-api:jar:1.7.36, so we can't use version 2 here. -->
            <version>1.7.36</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-path</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.ossindex.maven</groupId>
                <artifactId>ossindex-maven-plugin</artifactId>
                <configuration>

                    <excludeVulnerabilityIds>
                        <!-- Transitive test dependency xerces:xercesImpl:jar:2.12.2. We assume that we only connect to the known endpoint ExaOperations.-->
                        <exclude>CVE-2017-10355</exclude>
                        <!-- OSS Index exclusion for CVE-2017-7503 in xerces:xercesImpl; no CVE-free upgrade was found after trying no downloadable newer version -->
                        <exclude>CVE-2017-7503</exclude>
                    </excludeVulnerabilityIds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <configuration>
                    <!-- org.apache.parquet:parquet-column and org.apache.parquet:parquet-hadoop both contain classes shaded.parquet.it.unimi.dsi.fastutil.** -->
                    <failBuildInCaseOfEqualContentConflict>false</failBuildInCaseOfEqualContentConflict>
                    <failBuildInCaseOfConflict>false</failBuildInCaseOfConflict>
                    <printEqualFiles>false</printEqualFiles>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <!-- Avoid exception running integration tests caused by wrong XML parser (xerces:xercesImpl) beeing loaded:
                            java.lang.IllegalArgumentException: Property 'http://javax.xml.XMLConstants/property/accessExternalDTD' is not recognized.
                            at org.apache.xerces.jaxp.DocumentBuilderFactoryImpl.setAttribute(Unknown Source)
                            We can't exclude xerces:xercesImpl because it's required for performance tests, so we explicitly select the correct parser here. -->
                        <javax.xml.parsers.DocumentBuilderFactory>com.sun.org.apache.xerces.internal.jaxp.DocumentBuilderFactoryImpl</javax.xml.parsers.DocumentBuilderFactory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.exasol</groupId>
                <artifactId>project-keeper-maven-plugin</artifactId>
                <version>5.7.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
                <configuration>
                    <finalName>document-files-virtual-schema-dist-${vs-common-document-files.version}-azure-datalake-storage-gen2-${project.version}</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <parent>
        <artifactId>azure-data-lake-storage-gen2-document-files-virtual-schema-generated-parent</artifactId>
        <groupId>com.exasol</groupId>
        <version>3.0.2</version>
        <relativePath>pk_generated_parent.pom</relativePath>
    </parent>
</project>
